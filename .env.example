# Owner number in international format, digits only (Haiti: 509...)
OWNER_NUMBER=50940217685

# public = everyone can use commands; private = only owner can use commands
BOT_MODE=public
PREFIX=.
PORT=3000

# Optional: set to a WhatsApp number you control to request a pairing code at startup.
# Use digits only, including country code. Do not publish this number.
# PAIRING_NUMBER=509XXXXXXXX

# Optional: enables .gpt. Add your API key privately in Render Environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
